# .env.example — environment template (SAFE: no real keys, no real endpoints)
#
# Copy this file to `.env` and fill in your own values. `.env` is private and
# gitignored; it is never read, logged, or committed by the tool. This example
# ships placeholder values only — a placeholder is "not ready", and the
# semantic feature refuses to send it.
#
# The safe env resolver treats every value as plain data: never sourced,
# executed, evaluated, interpolated, or command-substituted. Credentials are
# never written to logs, caches, consent records, argv, or error messages.
#
# Scope: these values configure the consent-gated semantic code similarity
# (`make similar --code`, #115). They do NOT enable the feature and do NOT
# grant any authorization — `semantic_enabled` stays false by default.

# --- Embeddings provider (required for semantic code similarity) -----------
# Model name your embeddings provider expects.
EMBEDDINGS_MODEL=<your-embeddings-model>
# HTTPS endpoint URL. Must be HTTPS, with no credentials, query, or fragment.
EMBEDDINGS_ENDPOINT=<your-embeddings-endpoint-url>
# Provider API key. Keep it in your private .env only — never commit it.
EMBEDDINGS_API_KEY=<your-embeddings-api-key>

# --- Optional MCP server keys (only if you run these MCP servers) ----------
# context7 MCP server (header CONTEXT7_API_KEY). Not contacted by setting this.
CONTEXT7_API_KEY=<your-context7-api-key>
# exa MCP server (header x-api-key). Not contacted by setting this.
EXA_API_KEY=<your-exa-api-key>
