#!/bin/sh
# Launcher for tools/repoctl.py: picks the newest Python >= 3.11 on PATH, so
# hooks, make targets, and the git commit gate work even when `python3` is an
# older system interpreter. Set REPOCTL_PYTHON to force a specific one.
ok='import sys; sys.exit(sys.version_info < (3, 11))'
if [ -n "${REPOCTL_PYTHON:-}" ]; then
  "$REPOCTL_PYTHON" -c "$ok" 2>/dev/null && exec "$REPOCTL_PYTHON" "$(dirname "$0")/repoctl.py" "$@"
  echo "repoctl: REPOCTL_PYTHON=$REPOCTL_PYTHON is not a Python 3.11+ interpreter" >&2
  exit 127
fi
for candidate in python3.14 python3.13 python3.12 python3.11 python3 python; do
  command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c "$ok" 2>/dev/null; then
    exec "$candidate" "$(dirname "$0")/repoctl.py" "$@"
  fi
done
echo "repoctl: needs Python 3.11+ on PATH (python3.11 or newer); set REPOCTL_PYTHON to its path" >&2
exit 127
