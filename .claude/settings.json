{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/repoctl\" hook session-start"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/repoctl\" hook pre-compact"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/repoctl\" hook after-edit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/tools/repoctl\" hook stop"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(make start)",
      "Bash(make next)",
      "Bash(make ui-review)",
      "Bash(make done)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make verify)",
      "Bash(make map)",
      "Bash(make where:*)",
      "Bash(make garden)",
      "Bash(make risk)",
      "Bash(make capabilities)",
      "Bash(make sync)",
      "Bash(make handover)",
      "Bash(make inventory)",
      "Bash(make resources)",
      "Bash(make similar:*)",
      "Bash(make new:*)"
    ]
  }
}
